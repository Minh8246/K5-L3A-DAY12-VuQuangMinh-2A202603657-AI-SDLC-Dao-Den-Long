{
  "_comment": "Scenario headless của Phase 1. Mỗi case chạy qua CLI thật (headless_cmd trong game.contract.json). expect.events: các sự kiện phải xuất hiện theo đúng thứ tự [tick|null, name, data|null]; expect.absent: tên sự kiện không được xuất hiện; expect.end: so khớp các trường của dòng end.",
  "cases": [
    {
      "id": "walk-collect-light",
      "req": "R3, R4",
      "desc": "Đi thẳng +Z nhặt 5 đom đóm rồi interact cạnh L1 → deposit 5, L1 sáng",
      "seed": 1, "ticks": 120,
      "scenario": { "random_motes": false, "random_shades": false, "shades": [],
                    "motes": [[0, 0, 3], [0, 0, 4], [0, 0, 5], [0, 0, 6], [0, 0, 7]],
                    "lanterns": [{ "id": "L1", "pos": [0, 0, 9] }] },
      "inputs": { "frames": [ { "tick": 0, "move": [0, 1] }, { "tick": 70, "move": [0, 0] },
                              { "tick": 80, "interact": true }, { "tick": 81, "interact": false } ] },
      "expect": {
        "events": [
          [18, "mote_picked", { "carried": 1 }], [28, "mote_picked", { "carried": 2 }],
          [38, "mote_picked", { "carried": 3 }], [48, "mote_picked", { "carried": 4 }],
          [58, "mote_picked", { "carried": 5 }],
          [81, "deposit", { "lantern_id": "L1", "amount": 5, "deposited": 5 }],
          [81, "lantern_lit", { "lantern_id": "L1" }]
        ],
        "end": { "ticks": 120, "state": "playing", "score": 150 }
      }
    },
    {
      "id": "win-last-lantern",
      "req": "R5",
      "desc": "4 đèn sáng sẵn, nạp đèn cuối → thắng all_lit; đèn sáng sẵn không cộng điểm",
      "seed": 1, "ticks": 300,
      "scenario": { "random_motes": false, "random_shades": false, "motes": [], "shades": [],
                    "player": { "carried": 5 },
                    "lanterns": [{ "id": "L1", "lit": true }, { "id": "L2", "lit": true },
                                 { "id": "L3", "lit": true }, { "id": "L4", "lit": true },
                                 { "id": "L5", "pos": [0, 0, 2] }] },
      "inputs": { "frames": [ { "tick": 0, "interact": true } ] },
      "expect": {
        "events": [[1, "lantern_lit", { "lantern_id": "L5" }], [1, "game_over", { "result": "won", "reason": "all_lit" }]],
        "end": { "ticks": 1, "state": "won", "score": 848 }
      }
    },
    {
      "id": "shade-hits-until-lost",
      "req": "R6, R7",
      "desc": "Bóng Mực đuổi tới Mây đứng yên; 3 lần chạm cách nhau invuln 90 tick → thua no_flames",
      "seed": 1, "ticks": 2000,
      "scenario": { "random_motes": false, "random_shades": false, "motes": [],
                    "player": { "carried": 4 }, "shades": [{ "id": "S1", "pos": [5, 1, 0] }] },
      "expect": {
        "events": [
          [60, "player_hit", { "by": "shade", "flames": 2, "dropped": 2 }],
          [150, "player_hit", { "by": "shade", "flames": 1, "dropped": 1 }],
          [240, "player_hit", { "by": "shade", "flames": 0, "dropped": 0 }],
          [240, "game_over", { "result": "lost", "reason": "no_flames" }]
        ],
        "end": { "ticks": 240, "state": "lost", "score": 0 }
      }
    },
    {
      "id": "pulse-stuns-pushes",
      "req": "R8",
      "desc": "Tỏa sáng khi Bóng Mực ở 4 m → choáng + đẩy, không bị chạm trong lúc choáng",
      "seed": 1, "ticks": 170,
      "scenario": { "random_motes": false, "random_shades": false, "motes": [],
                    "player": { "carried": 2 }, "shades": [{ "id": "S1", "pos": [4, 1, 0] }] },
      "inputs": { "frames": [ { "tick": 0, "pulse": true } ] },
      "expect": {
        "events": [[1, "pulse", { "stunned_ids": ["S1"] }]],
        "absent": ["player_hit"],
        "end": { "ticks": 170, "state": "playing", "score": 25 }
      }
    },
    {
      "id": "safe-zone",
      "req": "R9",
      "desc": "Mây đứng cạnh đèn đã thắp; Bóng Mực không vào được safe_radius nên không chạm được Mây",
      "seed": 1, "ticks": 1200,
      "scenario": { "random_motes": false, "random_shades": false, "motes": [],
                    "player": { "pos": [0, 0, 10] },
                    "lanterns": [{ "id": "L1", "pos": [0, 0, 10], "lit": true }],
                    "shades": [{ "id": "S1", "pos": [0, 1, -10] }, { "id": "S2", "pos": [20, 1, 10] }] },
      "expect": { "absent": ["player_hit"], "end": { "ticks": 1200, "state": "playing" } }
    },
    {
      "id": "dawn",
      "req": "R10",
      "desc": "Còn 2 s → hết giờ ở tick 120 → thua dawn",
      "seed": 1, "ticks": 1000,
      "scenario": { "random_motes": false, "random_shades": false, "motes": [], "shades": [], "time_left_s": 2 },
      "expect": {
        "events": [[120, "game_over", { "result": "lost", "reason": "dawn" }]],
        "end": { "ticks": 120, "state": "lost", "score": 0 }
      }
    },
    {
      "id": "default-world-seed7",
      "req": "R1, R11",
      "desc": "Thế giới mặc định (ngẫu nhiên theo seed 7) với input lộn xộn — dùng để kiểm tra tất định",
      "seed": 7, "ticks": 3000,
      "inputs": { "frames": [ { "tick": 0, "move": [0.4, 1], "cam_yaw_deg": 25 }, { "tick": 100, "jump": true },
                              { "tick": 101, "jump": false, "pulse": true }, { "tick": 102, "pulse": false },
                              { "tick": 300, "move": [-1, -0.2], "cam_yaw_deg": -60 }, { "tick": 900, "move": [1, 1] } ] },
      "expect": {}
    }
  ]
}
